[Unit]
Description=Monk: local, Monk-only AgentEye (docker compose)
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Desktop/Projects/Monk
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash integrations/agenteye/up.sh
ExecStop=/usr/bin/docker compose -p agenteye-monk stop
TimeoutStartSec=600

[Install]
WantedBy=default.target
