# LLM: any OpenAI-compatible endpoint; ours is a LiteLLM proxy.
LLM_BASE_URL=https://models.aikin.club/v1
LLM_API_KEY=
# Model names as the proxy knows them. `pnpm monk models` lists the cheapest with tool calling.
MODEL=
VISION_MODEL=            # only the Phone helper uses it (needs patches/0001-subagent-models)

TRUEFORGE_URL=http://localhost:8790
GITHUB_TOKEN=            # fine-grained, sandbox + skills + demo repos only
GITHUB_MCP=docker        # docker | remote | binary
EVAL_REPO=                # owner/name of an empty sandbox repo
SKILLS_REPO_URL=         # public GitHub repo TrueForge loads skills from, e.g. https://github.com/<owner>/monk-skills
SKILLS_REPO_PATH=./data/skills-repo
DAYTONA_API_KEY=
# Optional: web_search uses Tavily when set, DuckDuckGo (no key) otherwise.
TAVILY_API_KEY=

TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
ALLOWED_USERS=           # telegram:<id>,discord:<id>

CHAOS_ENABLED=true
CHAOS_PROFILE=moderate
MONK_PHONE=false
TRUEFORGE_SUBAGENT_MODELS=false   # true only with patches/0001-subagent-models applied

# AgentEye JEV (classifier evaluations); leave empty to keep JEV off
AGENTEYE_JEV_ACCOUNT_ID=
AGENTEYE_JEV_TOKEN=

# Local AgentEye (pnpm monk agenteye up); keys are created on first setup
AGENTEYE_URL=http://localhost:8080
AGENTEYE_INGEST_KEY=
AGENTEYE_ENVIRONMENT=monk-live

# Models AgentEye uses on Monk's sessions (default: MODEL)
JUDGE_MODEL=
AUDIT_MODEL=
AGENTEYE_JEV_GATEWAY_ID=
AGENTEYE_JEV_BASE_URL=
